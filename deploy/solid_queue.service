# Solid Queue worker for ARC Duka (shop.rubycommunity.africa)
#
# Install as a SYSTEM-level systemd unit on the app server (see docs/DEPLOYMENT.md).
# A --user unit was tried first but wasn't reliable (needs `loginctl
# enable-linger` and a working user D-Bus session, which the web-console
# session used to set this up didn't have):
#   sudo cp /var/www/shop_rubycommunity_africa/current/deploy/solid_queue.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now solid_queue
#
# Capistrano restarts it after every deploy via `deploy:restart_solid_queue`
# (`sudo systemctl restart solid_queue` — needs a NOPASSWD sudoers entry for
# the deploy user, see docs/DEPLOYMENT.md).

[Unit]
Description=Solid Queue worker (ARC Duka)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
# `current` is the Capistrano release symlink; the deploy hook restarts this
# unit so it always picks up the new release.
WorkingDirectory=/var/www/shop_rubycommunity_africa/current
Environment=RAILS_ENV=production
Environment=HOME=/home/ubuntu
# `bash -lc` did not reliably load asdf under systemd (it fell back to the
# system Ruby and failed to parse the Gemfile), so the asdf shim dir is
# pinned directly instead of relying on a login shell.
Environment=PATH=/home/ubuntu/.asdf/shims:/home/ubuntu/.asdf/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/.asdf/shims/bundle exec ruby bin/jobs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
