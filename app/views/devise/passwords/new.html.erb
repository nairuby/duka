<div class="min-h-screen bg-gradient-to-br from-red-50 via-white to-orange-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <!-- Logo and Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="w-16 h-12 bg-red-600 rounded-xl flex items-center justify-center shadow-lg">
          <span class="text-white font-bold text-xl tracking-wide">ARC</span>
        </div>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Reset Password</h2>
      <p class="text-sm sm:text-base text-gray-600">Enter your email to receive reset instructions</p>
    </div>

    <!-- Reset Password Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="px-8 py-10">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <!-- Email Field -->
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-envelope text-red-600 mr-2"></i>Email Address
            <% end %>
            <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              placeholder: "admin@arcduka.com",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Submit Button -->
          <div>
            <%= f.submit "Send Reset Instructions", class: "w-full bg-red-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
          </div>
        <% end %>
      </div>

      <!-- Footer Links -->
      <div class="px-8 py-4 bg-gray-50 border-t border-gray-100">
        <div class="flex justify-center space-x-4 text-sm">
          <%= link_to "Sign in", new_session_path(resource_name), class: "text-red-600 hover:text-red-700 font-medium" %>
          <span class="text-gray-400">•</span>
          <%= link_to "Sign up", new_registration_path(resource_name), class: "text-red-600 hover:text-red-700 font-medium" %>
        </div>
      </div>
    </div>

    <!-- Back to Store -->
    <div class="text-center mt-6">
      <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-red-600 transition-colors duration-200" do %>
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Store
      <% end %>
    </div>
  </div>
</div>
