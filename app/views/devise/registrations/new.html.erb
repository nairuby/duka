<div class="min-h-screen bg-gradient-to-br from-red-50 via-white to-orange-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <!-- Logo and Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="w-16 h-12 bg-red-600 rounded-xl flex items-center justify-center shadow-lg">
          <span class="text-white font-bold text-xl tracking-wide">ARC</span>
        </div>
      </div>
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Create Account</h2>
      <p class="text-gray-600">Join ARC Duka Community</p>
    </div>

    <!-- Registration Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="px-8 py-10">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <!-- Email Field -->
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-envelope text-red-600 mr-2"></i>Email Address
            <% end %>
            <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Password Field -->
          <div>
            <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-lock text-red-600 mr-2"></i>Password
              <% if @minimum_password_length %>
                <span class="text-xs text-gray-500 font-normal">(<%= @minimum_password_length %> characters minimum)</span>
              <% end %>
            <% end %>
            <%= f.password_field :password, 
              autocomplete: "new-password",
              placeholder: "Create a strong password",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Password Confirmation Field -->
          <div>
            <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-lock text-red-600 mr-2"></i>Confirm Password
            <% end %>
            <%= f.password_field :password_confirmation, 
              autocomplete: "new-password",
              placeholder: "Re-enter your password",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Submit Button -->
          <div>
            <%= f.submit "Create Account", class: "w-full bg-red-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
          </div>
        <% end %>
      </div>

      <!-- Footer Links -->
      <div class="px-8 py-4 bg-gray-50 border-t border-gray-100">
        <p class="text-center text-sm text-gray-600">
          Already have an account?
          <%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-red-600 hover:text-red-700 ml-1" %>
        </p>
      </div>
    </div>

    <!-- Back to Store -->
    <div class="text-center mt-6">
      <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-red-600 transition-colors duration-200" do %>
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Store
      <% end %>
    </div>
  </div>
</div>
