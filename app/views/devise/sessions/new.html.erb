<div class="min-h-screen bg-gradient-to-br from-red-50 via-white to-orange-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <!-- Logo and Header -->
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="w-16 h-12 bg-red-600 rounded-xl flex items-center justify-center shadow-lg">
          <span class="text-white font-bold text-xl tracking-wide">ARC</span>
        </div>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Welcome Back</h2>
      <p class="text-sm sm:text-base text-gray-600">Sign in to access ARC Duka Admin</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
      <div class="px-8 py-10">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
          
          <!-- Email Field -->
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-envelope text-red-600 mr-2"></i>Email Address
            <% end %>
            <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              placeholder: "admin@arcduka.com",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Password Field -->
          <div>
            <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" do %>
              <i class="fas fa-lock text-red-600 mr-2"></i>Password
            <% end %>
            <%= f.password_field :password, 
              autocomplete: "current-password",
              placeholder: "Enter your password",
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
          </div>

          <!-- Remember Me & Forgot Password -->
          <div class="flex items-center justify-between">
            <% if devise_mapping.rememberable? %>
              <div class="flex items-center">
                <%= f.check_box :remember_me, class: "w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500" %>
                <%= f.label :remember_me, class: "ml-2 text-sm text-gray-600" %>
              </div>
            <% end %>

            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-red-600 hover:text-red-700 font-medium" %>
            <% end %>
          </div>

          <!-- Submit Button -->
          <div>
            <%= f.submit "Sign In", class: "w-full bg-red-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" %>
          </div>
        <% end %>
      </div>

      <!-- Footer Links -->
      <% if devise_mapping.registerable? %>
        <div class="px-8 py-4 bg-gray-50 border-t border-gray-100">
          <p class="text-center text-sm text-gray-600">
            Don't have an account?
            <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-red-600 hover:text-red-700 ml-1" %>
          </p>
        </div>
      <% end %>
    </div>

    <!-- Back to Store -->
    <div class="text-center mt-6">
      <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-red-600 transition-colors duration-200" do %>
        <i class="fas fa-arrow-left mr-2"></i>
        Back to Store
      <% end %>
    </div>
  </div>
</div>
