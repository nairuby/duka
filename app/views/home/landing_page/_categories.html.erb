<!-- Products by Category Section -->
<section class="py-16 px-4 bg-white">
  <div class="max-w-7xl mx-auto">
    <% @categories_with_products.each_with_index do |category_data, index| %>
      <% 
        category = category_data[:name]
        products = category_data[:products]
        cat_info = category_info(category)
      %>
      
      <!-- Category Section -->
      <div class="mb-16 <%= 'mt-16' if index > 0 %>">
        <!-- Category Header -->
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 <%= cat_info[:color] == 'red' ? 'bg-red-600' : cat_info[:color] == 'blue' ? 'bg-blue-600' : cat_info[:color] == 'green' ? 'bg-green-600' : cat_info[:color] == 'yellow' ? 'bg-yellow-600' : cat_info[:color] == 'orange' ? 'bg-orange-600' : cat_info[:color] == 'pink' ? 'bg-pink-600' : 'bg-purple-600' %> rounded-full flex items-center justify-center">
              <i class="<%= cat_info[:icon] %> text-white text-xl"></i>
            </div>
            <div>
              <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-800"><%= category %></h2>
              <p class="text-sm text-gray-600"><%= products.count %> <%= products.count == 1 ? 'product' : 'products' %> available</p>
            </div>
          </div>
          
          <%= link_to category_path(category), class: "group inline-flex items-center space-x-2 bg-white border-2 border-gray-200 text-gray-700 px-4 py-2 rounded-xl hover:border-red-600 hover:text-red-600 transition-all duration-200" do %>
            <span class="font-medium">View All</span>
            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200"></i>
          <% end %>
        </div>

        <!-- Products Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <% products.each_with_index do |product, prod_index| %>
            <%= link_to product_path(product), class: "group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-gray-200" do %>
              <div class="relative overflow-hidden">
                <!-- Badge for first product -->
                <% if prod_index == 0 %>
                  <div class="absolute top-4 left-4 z-10">
                    <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                      <i class="fas fa-fire mr-1"></i>Popular
                    </span>
                  </div>
                <% end %>
                
                <!-- Quick Add Button -->
                <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  <button class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-red-600 hover:text-white transition-all duration-200 shadow-lg">
                    <i class="fa-solid fa-heart text-sm"></i>
                  </button>
                </div>
                
                <!-- Product Image -->
                <div class="w-full h-48 bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center overflow-hidden">
                  <% if product.image_url.present? %>
                    <img src="<%= product.image_url %>" 
                         alt="<%= product.name %>" 
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                  <% else %>
                    <div class="text-center">
                      <i class="fas fa-image text-4xl text-gray-400 mb-2"></i>
                      <p class="text-gray-500 text-sm"><%= product.name %></p>
                    </div>
                  <% end %>
                </div>
                
                <!-- Overlay on Hover -->
                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
              
              <div class="p-4">
                <h3 class="text-base font-bold text-gray-800 mb-2 group-hover:text-red-600 transition-colors line-clamp-1"><%= product.name %></h3>
                <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= truncate(product.description, length: 50) %></p>
                
                <div class="flex items-center justify-between">
                  <span class="text-xl font-bold text-gray-800">
                    <%= format_price(product.price) %>
                  </span>
                  <div class="bg-red-600 text-white px-3 py-1.5 rounded-lg hover:bg-red-700 transition-all duration-200 flex items-center space-x-1 transform hover:scale-105">
                    <i class="fa-solid fa-eye text-xs"></i>
                    <span class="text-xs">View</span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- View All Products Button -->
    <div class="flex flex-col items-center mt-16">
      <%= link_to products_path, class: "group relative bg-red-600 text-white font-bold text-lg rounded-2xl hover:bg-red-700 transition-all duration-300 shadow-xl hover:shadow-2xl hover:shadow-red-500/25 transform hover:scale-105 inline-flex items-center justify-center space-x-3 overflow-hidden", style: "padding: 1rem 2.5rem;" do %>
        <!-- Animated background -->
        <div class="absolute inset-0 bg-gradient-to-r from-red-500 to-red-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <!-- Button content -->
        <span class="relative z-10">Explore All Products</span>
        <i class="fas fa-arrow-right relative z-10 group-hover:translate-x-1 transition-transform duration-300"></i>
        
        <!-- Shine effect -->
        <div class="absolute inset-0 -skew-x-12 bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-shine"></div>
      <% end %>
      
      <!-- Made in Africa Badge -->
      <div class="flex items-center justify-center mt-8 text-sm text-gray-600">
        <div class="flex items-center space-x-2 hover:text-red-600 transition-colors cursor-pointer">
          <i class="fas fa-heart text-red-600"></i>
          <span>Made in Africa</span>
        </div>
      </div>
    </div>
  </div>
</section>
