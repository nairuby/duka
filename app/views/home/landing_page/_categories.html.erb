<!-- Product Categories Grid Section -->
<section class="py-16 px-4 bg-white">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-4">Shop by Category</h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto">
        Find exactly what you're looking for. Browse our curated collections of Ruby community merchandise.
      </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Apparel Category -->
      <a href="#products" class="group relative bg-gradient-to-br from-red-50 to-pink-50 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-red-200">
        <div class="flex flex-col items-center text-center space-y-4">
          <!-- Icon Container -->
          <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-tshirt text-white text-3xl"></i>
          </div>
          
          <!-- Category Name -->
          <h3 class="text-xl font-bold text-gray-800 group-hover:text-red-600 transition-colors">Apparel</h3>
          
          <!-- Description -->
          <p class="text-sm text-gray-600">T-shirts, hoodies & more</p>
          
          <!-- Arrow Icon -->
          <div class="text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
            <i class="fas fa-arrow-right"></i>
          </div>
        </div>
      </a>

      <!-- Drinkware Category -->
      <a href="#products" class="group relative bg-gradient-to-br from-orange-50 to-amber-50 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-orange-200">
        <div class="flex flex-col items-center text-center space-y-4">
          <!-- Icon Container -->
          <div class="w-20 h-20 bg-orange-600 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-mug-hot text-white text-3xl"></i>
          </div>
          
          <!-- Category Name -->
          <h3 class="text-xl font-bold text-gray-800 group-hover:text-orange-600 transition-colors">Drinkware</h3>
          
          <!-- Description -->
          <p class="text-sm text-gray-600">Mugs & coffee cups</p>
          
          <!-- Arrow Icon -->
          <div class="text-orange-600 opacity-0 group-hover:opacity-100 transition-opacity">
            <i class="fas fa-arrow-right"></i>
          </div>
        </div>
      </a>

      <!-- Accessories Category -->
      <a href="#products" class="group relative bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-purple-200">
        <div class="flex flex-col items-center text-center space-y-4">
          <!-- Icon Container -->
          <div class="w-20 h-20 bg-purple-600 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-bookmark text-white text-3xl"></i>
          </div>
          
          <!-- Category Name -->
          <h3 class="text-xl font-bold text-gray-800 group-hover:text-purple-600 transition-colors">Accessories</h3>
          
          <!-- Description -->
          <p class="text-sm text-gray-600">Stickers, notebooks & gear</p>
          
          <!-- Arrow Icon -->
          <div class="text-purple-600 opacity-0 group-hover:opacity-100 transition-opacity">
            <i class="fas fa-arrow-right"></i>
          </div>
        </div>
      </a>

      <!-- Limited Edition Category -->
      <a href="#products" class="group relative bg-gradient-to-br from-gray-50 to-slate-50 rounded-2xl p-8 hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-gray-300">
        <div class="flex flex-col items-center text-center space-y-4">
          <!-- Icon Container -->
          <div class="w-20 h-20 bg-gray-800 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-gem text-white text-3xl"></i>
          </div>
          
          <!-- Category Name -->
          <h3 class="text-xl font-bold text-gray-800 group-hover:text-gray-700 transition-colors">Limited Edition</h3>
          
          <!-- Description -->
          <p class="text-sm text-gray-600">Exclusive releases</p>
          
          <!-- Arrow Icon -->
          <div class="text-gray-700 opacity-0 group-hover:opacity-100 transition-opacity">
            <i class="fas fa-arrow-right"></i>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>
