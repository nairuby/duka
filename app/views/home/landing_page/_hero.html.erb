<!-- Hero Section with dotted background pattern -->
<section class="relative bg-white overflow-hidden">
  <!-- Background dot pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle, #ef4444 1px, transparent 1px); background-size: 20px 20px;"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-12 items-center">
      
      <!-- Left Section: Hero Content -->
      <div class="space-y-6 sm:space-y-8 animate-fade-in-up">
        <!-- Category/Context with enhanced styling -->
        <div class="hidden sm:inline-flex items-center space-x-3 text-red-700 font-medium text-sm sm:text-base bg-red-50 px-4 py-2 rounded-full border border-red-200 hover:bg-red-100 transition-all duration-300 cursor-pointer group">
          <div class="w-2 h-2 bg-red-600 rounded-full group-hover:scale-125 transition-transform duration-200"></div>
          <span class="group-hover:text-red-800 transition-colors">African Ruby Community</span>
          <i class="fas fa-external-link-alt text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 ml-1"></i>
        </div>
        
        <!-- Main Headline with enhanced typography and animations -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          <span class="text-gray-800">Wear Your</span>
          <span class="text-red-600 bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent"> Ruby</span>
          <span class="text-gray-800"> Pride</span>
        </h1>
        
        <!-- Enhanced Description with better typography -->
        <div class="relative">
          <p class="text-base sm:text-lg lg:text-xl text-gray-700 leading-relaxed max-w-2xl hover:text-gray-800 transition-colors duration-300">
            Celebrate <span class="font-semibold text-red-600 hover:text-red-700 transition-colors">African excellence</span> in tech with our exclusive Ruby community merchandise. Every purchase supports <span class="font-semibold text-gray-800">local developers</span> and our growing community.
          </p>
          <!-- Decorative underline -->
          <div class="absolute -bottom-2 left-0 w-20 h-1 bg-gradient-to-r from-red-600 to-transparent rounded-full"></div>
        </div>
        
        <!-- Enhanced Call-to-Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <!-- Primary CTA Button -->
          <%= link_to categories_path, class: "group relative inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-red-600 text-white font-bold rounded-2xl hover:bg-red-700 transition-all duration-300 shadow-xl hover:shadow-2xl hover:shadow-red-500/25 text-sm sm:text-base transform hover:scale-105 hover:-translate-y-1 overflow-hidden" do %>
            <!-- Animated background -->
            <div class="absolute inset-0 bg-gradient-to-r from-red-500 to-red-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Button content -->
            <span class="relative z-10 mr-2">Shop Collection</span>
            <i class="fas fa-arrow-right relative z-10 group-hover:translate-x-1 transition-transform duration-300"></i>
            
            <!-- Shine effect -->
            <div class="absolute inset-0 -skew-x-12 bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-shine"></div>
          <% end %>
          
          <!-- Secondary CTA Button -->
          <%= link_to "https://rubycommunity.africa", target: "_blank", rel: "noopener noreferrer", class: "group relative inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-white text-gray-800 font-bold border-2 border-gray-300 rounded-2xl hover:border-red-400 hover:text-red-600 transition-all duration-300 text-sm sm:text-base transform hover:scale-105 hover:-translate-y-1 shadow-lg hover:shadow-xl overflow-hidden" do %>
            <!-- Animated background -->
            <div class="absolute inset-0 bg-gradient-to-r from-red-50 to-pink-50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            
            <!-- Button content -->
            <span class="relative z-10 mr-2">Join Community</span>
            <i class="fas fa-users relative z-10 group-hover:scale-110 transition-transform duration-300"></i>
            
            <!-- Border animation -->
            <div class="absolute inset-0 rounded-2xl border-2 border-red-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300 animate-pulse"></div>
          <% end %>
        </div>
        
        <!-- Enhanced Motto/Footer Text -->
        <div class="flex items-center space-x-3 text-gray-600 text-xs sm:text-sm group cursor-pointer hover:text-red-600 transition-colors duration-300">
          <div class="relative">
            <i class="fas fa-heart text-red-500 group-hover:scale-125 transition-transform duration-300 animate-pulse"></i>
            <!-- Heart beat effect -->
            <div class="absolute inset-0 rounded-full bg-red-500/20 scale-0 group-hover:scale-150 transition-transform duration-500 opacity-0 group-hover:opacity-100"></div>
          </div>
          <span class="font-medium group-hover:font-semibold transition-all duration-300">Made with love in Africa</span>
          <div class="flex space-x-1">
            <div class="w-2 h-2 bg-green-500 rounded-full animate-bounce"></div>
            <div class="w-2 h-2 bg-yellow-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
            <div class="w-2 h-2 bg-red-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
          </div>
        </div>
        
        <!-- Community Stats -->
        <div class="flex items-center space-x-6 text-xs sm:text-sm text-gray-500 pt-4 border-t border-gray-200">
          <div class="flex items-center space-x-2 hover:text-red-600 transition-colors cursor-pointer">
            <i class="fas fa-users text-red-500"></i>
            <span class="font-medium">4,000+ Members</span>
          </div>
        </div>
      </div>
      
      <!-- Right Section: Product Display Card -->
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <div class="relative group">
          <!-- Product Card -->
          <div class="relative bg-pink-50 rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-3 hover:rotate-1 border-2 border-transparent hover:border-red-200" style="background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #fdf2f8 100%);">
            
            <!-- Floating badges -->
            <div class="absolute -top-3 -left-3 z-20">
              <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg animate-pulse">
                <i class="fas fa-fire mr-1"></i>Featured
              </span>
            </div>
            
            <div class="absolute -top-3 -right-3 z-20 opacity-0 group-hover:opacity-100 transition-all duration-300">
              <button class="w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-red-600 hover:text-white transition-all duration-200 shadow-lg transform hover:scale-110">
                <i class="fa-solid fa-heart text-lg"></i>
              </button>
            </div>
            
            <!-- Subtle red glow effect -->
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-b from-red-100/30 via-transparent to-red-100/30 group-hover:from-red-200/40 group-hover:to-red-200/40 transition-all duration-500"></div>
            
            <!-- Product Image Container -->
            <div class="relative z-10 flex justify-center mb-4 sm:mb-6 overflow-hidden rounded-2xl">
              <div class="w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 bg-gradient-to-br from-red-100 to-orange-100 rounded-xl sm:rounded-2xl p-3 sm:p-4 flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
                <%= image_tag asset_path("pattern-shirt.png"), 
                    class: "w-full h-full object-cover rounded-lg sm:rounded-xl group-hover:scale-110 transition-transform duration-700", 
                    alt: "African Ruby Community T-shirt with geometric pattern" %>
              </div>
              
              <!-- Floating elements -->
              <div class="absolute top-4 left-4">
                <span class="bg-orange-100 text-orange-700 text-xs font-medium px-3 py-1 rounded-full border border-orange-200">
                  <i class="fas fa-tshirt mr-1"></i>Premium Cotton
                </span>
              </div>
            </div>
            
            <!-- Product Details -->
            <div class="relative z-10 text-center">
              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-red-800 mb-2 group-hover:text-red-600 transition-colors duration-300">Heritage Ruby Tee</h3>
              <p class="text-gray-600 text-xs sm:text-sm mb-3 sm:mb-4 group-hover:text-gray-700 transition-colors">Limited Edition • African Inspired Design</p>
              
              <!-- Pricing -->
              <div class="flex items-center justify-center space-x-2 sm:space-x-3 mb-4">
                <span class="text-2xl sm:text-3xl lg:text-4xl font-bold text-red-600 group-hover:scale-110 transition-transform duration-300">$29</span>
                <span class="text-lg sm:text-xl text-gray-400 line-through">$39</span>
              </div>
              
              <!-- Quick Action Buttons -->
              <div class="flex gap-3 justify-center">
                <button class="bg-red-600 text-white px-6 py-2 rounded-xl hover:bg-red-700 transition-all duration-200 flex items-center space-x-2 transform hover:scale-105 shadow-lg">
                  <i class="fa-solid fa-cart-plus"></i>
                  <span class="text-sm font-semibold">Quick Add</span>
                </button>
                <button class="bg-white text-red-600 px-4 py-2 rounded-xl border-2 border-red-200 hover:border-red-400 transition-all duration-200 transform hover:scale-105">
                  <i class="fa-solid fa-eye text-sm"></i>
                </button>
              </div>
            </div>
            
            <!-- Decorative elements -->
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-red-200 rounded-full opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
            <div class="absolute -top-1 -left-1 w-6 h-6 bg-orange-200 rounded-full opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
          </div>
          
          <!-- Floating shadow effect -->
          <div class="absolute inset-0 bg-red-600/10 rounded-3xl blur-xl opacity-0 group-hover:opacity-30 transition-all duration-500 transform scale-95 group-hover:scale-100"></div>
        </div>
      </div>
      
    </div>
  </div>
</section>
