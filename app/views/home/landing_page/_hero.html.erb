<!-- Hero Section with dotted background pattern -->
<section class="relative bg-white overflow-hidden">
  <!-- Background dot pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle, #ef4444 1px, transparent 1px); background-size: 20px 20px;"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-12 items-center">
      
      <!-- Left Section: Hero Content -->
      <div class="space-y-6 sm:space-y-8">
        <!-- Category/Context -->
        <div class="inline-flex items-center space-x-2 text-red-700 font-medium text-sm sm:text-base">
          <span class="text-lg">&lt;</span>
          <span>African Ruby Community</span>
          <span class="text-lg">&gt;</span>
        </div>
        
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          <span class="text-gray-800">Wear Your</span>
          <span class="text-red-600"> Ruby</span>
          <span class="text-gray-800"> Pride</span>
        </h1>
        
        <!-- Description -->
        <p class="text-base sm:text-lg lg:text-xl text-gray-700 leading-relaxed max-w-2xl">
          Celebrate African excellence in tech with our exclusive Ruby community merchandise. Every purchase supports local developers and our growing community.
        </p>
        
        <!-- Call-to-Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <button class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors duration-200 shadow-lg text-sm sm:text-base">
            Shop Collection
            <i class="fas fa-arrow-right ml-2"></i>
          </button>
          
          <button class="inline-flex items-center justify-center px-6 sm:px-8 py-3 sm:py-4 bg-white text-gray-800 font-semibold border-2 border-gray-300 rounded-lg hover:border-red-300 hover:text-red-600 transition-all duration-200 text-sm sm:text-base">
            Join Community
          </button>
        </div>
        
        <!-- Motto/Footer Text -->
        <div class="flex items-center space-x-2 text-gray-600 text-xs sm:text-sm">
          <i class="fas fa-heart text-red-500"></i>
          <span>Made with love in Africa</span>
        </div>
      </div>
      
      <!-- Right Section: Product Display Card -->
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <div class="relative">
          <!-- Product Card -->
          <div class="relative bg-pink-50 rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-2xl" style="background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #fdf2f8 100%);">
            <!-- Subtle red glow effect -->
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-b from-red-100/30 via-transparent to-red-100/30"></div>
            
            <!-- Product Image Container -->
            <div class="relative z-10 flex justify-center mb-4 sm:mb-6">
              <div class="w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 bg-gradient-to-br from-red-100 to-orange-100 rounded-xl sm:rounded-2xl p-3 sm:p-4 flex items-center justify-center">
                <%= image_tag asset_path("pattern-shirt.png"), 
                    class: "w-full h-full object-cover rounded-lg sm:rounded-xl", 
                    alt: "African Ruby Community T-shirt with geometric pattern" %>
              </div>
            </div>
            
            <!-- Product Details -->
            <div class="relative z-10 text-center">
              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-red-800 mb-2">Heritage Ruby Tee</h3>
              <p class="text-gray-600 text-xs sm:text-sm mb-3 sm:mb-4">Limited Edition</p>
              
              <!-- Pricing -->
              <div class="flex items-center justify-center space-x-2 sm:space-x-3">
                <span class="text-2xl sm:text-3xl lg:text-4xl font-bold text-red-600">$29</span>
                <span class="text-lg sm:text-xl text-gray-400 line-through">$39</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
