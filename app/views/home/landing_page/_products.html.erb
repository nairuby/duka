<!-- All Products Section -->
<section id="products" class="py-16 px-4 bg-red-100/30">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4">All Products</h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto">
        Browse our complete collection of Ruby community merchandise, each piece designed to showcase your passion for programming and African heritage.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Space Black Coffee Mug -->
      <div class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-gray-200">
        <div class="relative overflow-hidden">
          <!-- Quick Add Button -->
          <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
            <button class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-red-600 hover:text-white transition-all duration-200 shadow-lg">
              <i class="fa-solid fa-heart text-sm"></i>
            </button>
          </div>
          
          <!-- Product Image -->
          <div class="w-full h-64 bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center overflow-hidden">
            <%= image_tag asset_path("black-mug.png"), 
                    class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500", 
                    alt: "Space Black Coffee Mug" %>
          </div>
          
          <!-- Category Badge -->
          <div class="absolute bottom-4 left-4">
            <span class="bg-orange-100 text-orange-700 text-xs font-medium px-3 py-1 rounded-full border border-orange-200">
              <i class="fas fa-mug-hot mr-1"></i>Drinkware
            </span>
          </div>
          
          <!-- Overlay on Hover -->
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        
        <div class="p-6">
          <h3 class="text-lg font-bold text-gray-800 mb-2 group-hover:text-red-600 transition-colors">Space Black Coffee Mug</h3>
          <p class="text-sm text-gray-600 mb-4">Premium ceramic mug with Ruby logo</p>
          
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-2xl font-bold text-gray-800">$18</span>
              <span class="text-sm text-gray-400 line-through">$24</span>
            </div>
            <button class="bg-red-600 text-white px-4 py-2 rounded-xl hover:bg-red-700 transition-all duration-200 flex items-center space-x-2 transform hover:scale-105 shadow-lg hover:shadow-xl">
              <i class="fa-solid fa-cart-plus"></i>
              <span class="hidden sm:inline">Add to Cart</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Pearl White Coffee Mug -->
      <div class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-gray-200">
