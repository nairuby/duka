<!-- All Products Section -->
<section class="py-16 px-4 bg-red-100/30">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4">All Products</h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto">
        Browse our complete collection of Ruby community merchandise, each piece designed to showcase your passion for programming and African heritage.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Space Black Coffee Mug -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="relative">
          <div class="absolute top-3 right-3">
            <button class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center hover:bg-gray-300 transition-colors">
              <i class="fa-solid fa-cart-plus"></i>
            </button>
          </div>
          <div class="w-full h-64 bg-gray-100 flex items-center justify-center">
            <%= image_tag asset_path("black-mug.png"), 
                    class: "w-full h-full object-cover", 
                    alt: "Space Black Coffee Mug" %>
          </div>
          <div class="absolute bottom-3 left-3">
            <span class="bg-gray-200 text-gray-700 text-xs font-medium px-2 py-1 rounded-full">Drinkware</span>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-base sm:text-lg font-semibold text-gray-800 mb-2">Space Black Coffee Mug</h3>
          <div class="flex items-center justify-between">
            <span class="text-base sm:text-xl font-bold text-gray-800">$18</span>
            <button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center space-x-2">
              <i class="fa-solid fa-cart-plus"></i>
              <span>Add to Cart</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Pearl White Coffee Mug -->
