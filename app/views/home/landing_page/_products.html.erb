<!-- All Products Section -->
<section id="products" class="py-16 px-4 bg-red-100/30">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4">All Products</h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto">
        Browse our complete collection of Ruby community merchandise, each piece designed to showcase your passion for programming and African heritage.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @products.each_with_index do |product, index| %>
        <%= link_to product_path(product), class: "group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border-2 border-transparent hover:border-gray-200" do %>
          <div class="relative overflow-hidden">
            <!-- Dynamic Badge based on index -->
            <% if index == 0 %>
              <div class="absolute top-4 left-4 z-10">
                <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                  <i class="fas fa-fire mr-1"></i>Popular
                </span>
              </div>
            <% elsif index == 1 %>
              <div class="absolute top-4 left-4 z-10">
                <span class="bg-green-600 text-white text-xs font-bold px-3 py-1 rounded-full">
                  <i class="fas fa-star mr-1"></i>New
                </span>
              </div>
            <% end %>
            
            <!-- Quick Add Button -->
            <div class="absolute top-4 right-4 z-10 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
              <button class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-red-600 hover:text-white transition-all duration-200 shadow-lg">
                <i class="fa-solid fa-heart text-sm"></i>
              </button>
            </div>
            
            <!-- Product Image -->
            <div class="w-full h-64 bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center overflow-hidden">
              <% if product.image_url.present? %>
                <img src="<%= product.image_url %>" 
                     alt="<%= product.name %>" 
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <% else %>
                <div class="text-center">
                  <i class="fas fa-image text-4xl text-gray-400 mb-2"></i>
                  <p class="text-gray-500 text-sm"><%= product.name %></p>
                </div>
              <% end %>
            </div>
            
            <!-- Category Badge -->
            <div class="absolute bottom-4 left-4">
              <% category = product_category(product) %>
              <span class="<%= category_badge_classes(category[:color]) %> text-xs font-medium px-3 py-1 rounded-full border">
                <i class="<%= category[:icon] %> mr-1"></i><%= category[:name] %>
              </span>
            </div>
            
            <!-- Overlay on Hover -->
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          
          <div class="p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-2 group-hover:text-red-600 transition-colors"><%= product.name %></h3>
            <p class="text-sm text-gray-600 mb-4"><%= truncate(product.description, length: 60) %></p>
            
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-2xl font-bold text-gray-800">
                  <%= product.currency %><%= number_with_precision(product.price, precision: 2) %>
                </span>
              </div>
              <div class="bg-red-600 text-white px-4 py-2 rounded-xl hover:bg-red-700 transition-all duration-200 flex items-center space-x-2 transform hover:scale-105 shadow-lg hover:shadow-xl">
                <i class="fa-solid fa-eye"></i>
                <span class="hidden sm:inline">View Details</span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      
      <!-- Show placeholder cards if we have fewer than 6 products -->
      <% if @products.count < 6 %>
        <% (6 - @products.count).times do %>
          <div class="group bg-gray-50 rounded-2xl shadow-lg overflow-hidden border-2 border-dashed border-gray-300">
            <div class="w-full h-64 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
              <div class="text-center">
                <i class="fas fa-plus text-4xl text-gray-400 mb-2"></i>
                <p class="text-gray-500 text-sm">More products coming soon</p>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-400 mb-2">Coming Soon</h3>
              <p class="text-sm text-gray-400 mb-4">New products will be added here</p>
              <div class="flex items-center justify-between">
                <span class="text-2xl font-bold text-gray-400">$--</span>
                <div class="bg-gray-400 text-white px-4 py-2 rounded-xl">
                  <span class="text-sm">Soon</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
    
    <!-- Spacer for visual separation -->
    <div class="h-16 sm:h-20 lg:h-24"></div>
    
    <!-- View All Products Button -->
    <div class="flex flex-col items-center mb-16">
      <%= link_to products_path, class: "group relative bg-red-600 text-white font-bold text-lg rounded-2xl hover:bg-red-700 transition-all duration-300 shadow-xl hover:shadow-2xl hover:shadow-red-500/25 transform hover:scale-105 inline-flex items-center justify-center space-x-3 overflow-hidden", style: "padding: 1rem 2.5rem;" do %>
        <!-- Animated background -->
        <div class="absolute inset-0 bg-gradient-to-r from-red-500 to-red-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <!-- Button content -->
        <span class="relative z-10">Explore All Products</span>
        <i class="fas fa-arrow-right relative z-10 group-hover:translate-x-1 transition-transform duration-300"></i>
        
        <!-- Shine effect -->
        <div class="absolute inset-0 -skew-x-12 bg-gradient-to-r from-transparent via-white/20 to-transparent opacity-0 group-hover:opacity-100 group-hover:animate-shine"></div>
      <% end %>
      
      <!-- Simplified Stats - Only Made in Africa -->
      <div class="flex items-center justify-center mt-8 text-sm text-gray-600">
        <div class="flex items-center space-x-2 hover:text-red-600 transition-colors cursor-pointer">
          <i class="fas fa-heart text-red-600"></i>
          <span>Made in Africa</span>
        </div>
      </div>
    </div>
  </div>
</section>
