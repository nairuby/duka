              <span class="text-sm text-gray-400 line-through">$24</span>
            </div>
            <button class="bg-red-600 text-white px-4 py-2 rounded-xl hover:bg-red-700 transition-all duration-200 flex items-center space-x-2 transform hover:scale-105 shadow-lg hover:shadow-xl">
