<!-- Featured Products Section -->
<section class="py-16 px-4 bg-white">
  <div class="max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <div class="inline-block bg-red-600 text-white text-sm font-medium px-3 py-1 rounded-full mb-4">
        Featured Products
      </div>
      <h2 class="text-4xl font-bold text-gray-800 mb-4">Community Favorites</h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Discover our most loved items, crafted with pride and designed to celebrate the intersection of African culture and Ruby programming excellence.
      </p>
    </div>

    <!-- Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Ruby Gem Coffee Mug -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-gray-100">
        <div class="relative">
          <div class="absolute top-3 left-3">
            <span class="bg-red-600 text-white text-xs font-medium px-2 py-1 rounded-full">Best Seller</span>
          </div>
          <div class="w-full h-64 bg-gray-100 flex items-center justify-center">
            <%= image_tag asset_path("coffee-mug.png"), 
                    class: "w-full h-full object-cover", 
                    alt: "Code & Culture Hoodie" %>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-sm text-gray-600 ml-1">4.9 (127)</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-800 mb-2">Ruby Gem Coffee Mug</h3>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-xl font-bold text-red-600">$18</span>
              <span class="text-sm text-gray-500 line-through">$25</span>
            </div>
            <button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m6 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01M7 13h10"></path>
              </svg>
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Code & Culture Hoodie -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-gray-100">
        <div class="relative">
          <div class="absolute top-3 left-3">
            <span class="bg-red-600 text-white text-xs font-medium px-2 py-1 rounded-full">New</span>
          </div>
          <div class="w-full h-64 bg-gray-100 flex items-center justify-center">
            <%= image_tag asset_path("pattern-hoodie.png"), 
                    class: "w-full h-full object-cover", 
                    alt: "Code & Culture Hoodie" %>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-sm text-gray-600 ml-1">4.8 (89)</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-800 mb-2">Code & Culture Hoodie</h3>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-xl font-bold text-red-600">$45</span>
              <span class="text-sm text-gray-500 line-through">$60</span>
            </div>
            <button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m6 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01M7 13h10"></path>
              </svg>
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Ruby Developer Sticker Pack -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-gray-100">
        <div class="relative">
          <div class="absolute top-3 left-3">
            <span class="bg-red-600 text-white text-xs font-medium px-2 py-1 rounded-full">Limited</span>
          </div>
          <div class="w-full h-64 bg-white flex items-center justify-center">
            <%= image_tag asset_path("sticker-pack.png"), 
                    class: "w-full h-full object-cover", 
                    alt: "Ruby Developer Sticker Pack" %>
          </div>
        </div>
        <div class="p-6">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-sm text-gray-600 ml-1">5.0 (203)</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-800 mb-2">Ruby Developer Sticker Pack</h3>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-xl font-bold text-red-600">$12</span>
              <span class="text-sm text-gray-500 line-through">$15</span>
            </div>
            <button class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors flex items-center space-x-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m6 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01M7 13h10"></path>
              </svg>
              <span>Add</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
