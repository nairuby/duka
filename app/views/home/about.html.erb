<%= render 'shared/navbar' %>

<%# ── STORY SECTION ── %>
<section class="py-20 lg:py-28 px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <%# Left: Story text %>
      <div class="space-y-6">
        <!-- Badge -->
        <a href="https://rubycommunity.africa" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-3 text-red-700 font-medium text-sm sm:text-base bg-red-50 px-4 py-2 rounded-full border border-red-200 hover:bg-red-100 transition-all duration-300 cursor-pointer group">
          <div class="w-2 h-2 bg-red-600 rounded-full group-hover:scale-125 transition-transform duration-200"></div>
          <span class="group-hover:text-red-800 transition-colors">African Ruby Community</span>
          <i class="fas fa-external-link-alt text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 ml-1"></i>
        </a>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
          <span class="text-gray-800">About</span>
          <span class="text-red-600 bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent"> ARC</span>
        </h1>

        <!-- Content Block with Decorative Line -->
        <div class="relative space-y-6">
          <p class="text-base sm:text-lg text-gray-700 leading-relaxed hover:text-gray-800 transition-colors duration-300">
            <span class="font-semibold text-red-600">African Ruby Community (ARC)</span> was founded in 2010. Today, our reach extends to over <span class="font-semibold text-gray-800">5,000 members</span> across East Africa—bringing together developers, entrepreneurs, designers, and freelancers.
          </p>

          <p class="text-base sm:text-lg text-gray-700 leading-relaxed hover:text-gray-800 transition-colors duration-300">
            We focus on open-source <span class="font-semibold text-red-600 hover:text-red-700 transition-colors">Ruby technologies</span> that empower startups to build fast and innovate early. Through weekly and monthly meetups alongside our annual <span class="font-semibold text-gray-800">Ruby Conference</span>, we bridge the gap between education and industry.
          </p>

          <p class="text-base sm:text-lg text-gray-700 leading-relaxed hover:text-gray-800 transition-colors duration-300">
            We believe in a holistic approach: combining entrepreneurship, a solution-oriented mindset, and open source to solve real-world challenges while inspiring developers to reach their full potential.
          </p>

          <!-- Decorative underline -->
          <div class="absolute -bottom-4 left-0 w-20 h-1 bg-gradient-to-r from-red-600 to-transparent rounded-full"></div>
        </div>
      </div>

      <%# Right: Pull quote / Stats sidebar %>
      <div class="space-y-8 lg:pt-12">
        <div class="bg-gradient-to-br from-red-50 to-white p-8 rounded-2xl border border-red-100 shadow-sm relative overflow-hidden">
          <div class="absolute -right-4 -bottom-4 text-red-100 opacity-50 text-9xl font-bold select-none pointer-events-none">
            ARC
          </div>

          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-rocket text-red-600"></i>
            Our Impact
          </h3>

          <div class="grid grid-cols-2 gap-4 text-center">
            <div class="p-4 bg-white rounded-xl border border-red-100 shadow-2xs">
              <span class="block text-3xl font-extrabold text-red-600">5,000+</span>
              <span class="text-xs text-gray-600 font-medium">Community Members</span>
            </div>
            <div class="p-4 bg-white rounded-xl border border-red-100 shadow-2xs">
              <span class="block text-3xl font-extrabold text-red-600">2010</span>
              <span class="text-xs text-gray-600 font-medium">Year Established</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<%= render 'shared/footer' %>