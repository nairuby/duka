<!-- Top red strip -->
<div class="w-full h-1 bg-red-600"></div>

<!-- Main navbar -->
<nav class="bg-white shadow-sm relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Brand/Logo Section -->
      <%= link_to root_path, class: "mt-2 flex hover:opacity-80 transition-opacity duration-200" do %>
        <!-- ARC Logo -->
        <%= image_tag('arc_logo_coloured.png', alt: "RubyCommunity Africa Logo", class: 'w-36 mb-4') %>

      <% end %>

      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center space-x-8">
        <!-- Products Dropdown -->
        <div class="relative group">
          <button class="text-gray-700 hover:text-red-600 transition-colors duration-200 flex items-center space-x-1">
            <span>Products</span>
            <i class="fas fa-chevron-down text-xs"></i>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              <%= link_to category_path('Shirts'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-tshirt w-5"></i> Shirts
              <% end %>
              <%= link_to category_path('Hoodies'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-vest w-5"></i> Hoodies
              <% end %>
              <%= link_to category_path('Hats'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-hat-cowboy w-5"></i> Hats
              <% end %>
              <%= link_to category_path('Bags'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-bag-shopping w-5"></i> Bags
              <% end %>
              <%= link_to category_path('Mugs'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-mug-hot w-5"></i> Mugs
              <% end %>
              <%= link_to category_path('Stickers'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-note-sticky w-5"></i> Stickers
              <% end %>
              <%= link_to category_path('Accessories'), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <i class="fas fa-gift w-5"></i> Accessories
              <% end %>
              <div class="border-t border-gray-200 my-1"></div>
              <%= link_to products_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors font-medium" do %>
                <i class="fas fa-th w-5"></i> All Products
              <% end %>
            </div>
          </div>
        </div>

        <a href="/about_us" class="text-gray-700 hover:text-red-600 transition-colors duration-200">About Us</a>
        <a href="#" class="text-gray-700 hover:text-red-600 transition-colors duration-200" style="display: none">Community</a>
        <a href="#" class="text-gray-700 hover:text-red-600 transition-colors duration-200" style="display: none">Contact</a>
      </div>

      <!-- Desktop Utility Icons -->
      <div class="hidden md:flex items-center space-x-4">
        <!-- Currency Selector -->
        <div class="relative group">
          <button class="flex items-center space-x-1 text-gray-700 hover:text-red-600 transition-colors duration-200">
            <span class="font-medium"><%= Current.currency %></span>
            <i class="fas fa-chevron-down text-xs"></i>
          </button>
          <div class="absolute right-0 mt-2 w-24 bg-white rounded-lg shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-1">
              <%= button_to "KES", currency_path(currency: "KES"), method: :patch, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 #{'font-bold text-red-600' if Current.currency == 'KES'}" %>
              <%= button_to "USD", currency_path(currency: "USD"), method: :patch, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 #{'font-bold text-red-600' if Current.currency == 'USD'}" %>
            </div>
          </div>
        </div>

        <!-- Search Icon -->
        <button class="text-gray-700 hover:text-red-600 transition-colors duration-200" style="display: none" aria-label="Search">
          <i class="fas fa-search text-xl"></i>
        </button>

        <!-- Shopping Cart with Notification -->
        <div class="relative">
          <button onclick="window.openCart()" class="text-gray-700 hover:text-red-600 transition-colors duration-200 p-2 -m-2 rounded-md hover:bg-red-50" aria-label="Open cart">
            <i class="fas fa-shopping-cart text-xl"></i>
            <!-- Cart Notification Badge -->
            <% if current_cart.total_items > 0 %>
              <span class="absolute -top-2 -right-2 w-5 h-5 bg-red-600 rounded-full flex items-center justify-center pointer-events-none">
                <%= render 'shared/cart_count', count: current_cart.total_items %>
              </span>
            <% end %>
          </button>
        </div>
      </div>

      <!-- Mobile Utility Icons and Menu Button -->
      <div class="flex md:hidden items-center space-x-3">
        <!-- Mobile Search Icon -->
        <button class="text-gray-700 hover:text-red-600 transition-colors duration-200" aria-label="Search">
          <i class="fas fa-search text-lg"></i>
        </button>

        <!-- Mobile Shopping Cart -->
        <div class="relative">
          <button onclick="window.openCart()" class="text-gray-700 hover:text-red-600 transition-colors duration-200 p-2 -m-2 rounded-md hover:bg-red-50" aria-label="Open cart">
            <i class="fas fa-shopping-cart text-lg"></i>
            <!-- Cart Notification Badge -->
            <% if current_cart.total_items > 0 %>
              <span class="absolute -top-2 -right-2 w-4 h-4 bg-red-600 rounded-full flex items-center justify-center pointer-events-none">
                <%= render 'shared/cart_count', count: current_cart.total_items %>
              </span>
            <% end %>
          </button>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-button" class="text-gray-700 hover:text-red-600 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-red-600 focus:ring-opacity-50 rounded-md p-1" aria-label="Toggle mobile menu">
          <i class="fa-solid fa-bars" id="mobile-menu-icon"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-gray-200">
      <div class="px-2 pt-2 pb-3 space-y-1">
        <!-- Products with submenu -->
        <div>
          <button id="mobile-products-toggle" class="w-full flex items-center justify-between px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200">
            <span>Products</span>
            <i class="fas fa-chevron-down text-xs" id="mobile-products-icon"></i>
          </button>
          <div id="mobile-products-submenu" class="hidden pl-4 mt-1 space-y-1">
            <%= link_to category_path('Shirts'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-tshirt w-5"></i> Shirts
            <% end %>
            <%= link_to category_path('Hoodies'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-vest w-5"></i> Hoodies
            <% end %>
            <%= link_to category_path('Hats'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-hat-cowboy w-5"></i> Hats
            <% end %>
            <%= link_to category_path('Bags'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-bag-shopping w-5"></i> Bags
            <% end %>
            <%= link_to category_path('Mugs'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-mug-hot w-5"></i> Mugs
            <% end %>
            <%= link_to category_path('Stickers'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-note-sticky w-5"></i> Stickers
            <% end %>
            <%= link_to category_path('Accessories'), class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md" do %>
              <i class="fas fa-gift w-5"></i> Accessories
            <% end %>
            <%= link_to products_path, class: "block px-3 py-2 text-sm text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md font-medium" do %>
              <i class="fas fa-th w-5"></i> All Products
            <% end %>
          </div>
        </div>

        <a href="#" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200">About
          Us</a>
        <a href="#" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200">Community</a>
        <a href="#" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors duration-200">Contact</a>
      </div>
    </div>
  </div>
</nav>

<!-- JavaScript for Mobile Menu Toggle -->
<script data-turbo-eval="false">
    (function () {
        'use strict';

        function initializeNavbar() {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            const productsToggle = document.getElementById('mobile-products-toggle');
            const productsSubmenu = document.getElementById('mobile-products-submenu');
            const productsIcon = document.getElementById('mobile-products-icon');

            if (!mobileMenuButton || !mobileMenu) {
                console.log('Navbar elements not found');
                return;
            }

            console.log('Initializing navbar...');

            // Main mobile menu toggle
            mobileMenuButton.onclick = function (e) {
                e.preventDefault();
                e.stopPropagation();

                const isHidden = mobileMenu.classList.contains('hidden');
                mobileMenu.classList.toggle('hidden');

                // Toggle hamburger icon to X when menu is open
                const icon = mobileMenuButton.querySelector('#mobile-menu-icon');
                if (icon) {
                    if (isHidden) {
                        icon.classList.remove('fa-bars');
                        icon.classList.add('fa-xmark');
                    } else {
                        icon.classList.remove('fa-xmark');
                        icon.classList.add('fa-bars');
                    }
                }
            };

            // Products submenu toggle
            if (productsToggle && productsSubmenu && productsIcon) {
                productsToggle.onclick = function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const isHidden = productsSubmenu.classList.contains('hidden');
                    productsSubmenu.classList.toggle('hidden');

                    // Rotate chevron icon
                    if (isHidden) {
                        productsIcon.classList.remove('fa-chevron-down');
                        productsIcon.classList.add('fa-chevron-up');
                    } else {
                        productsIcon.classList.remove('fa-chevron-up');
                        productsIcon.classList.add('fa-chevron-down');
                    }
                };
            }

            // Close mobile menu when clicking on a link
            const mobileMenuLinks = mobileMenu.querySelectorAll('a');
            mobileMenuLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    mobileMenu.classList.add('hidden');
                    const icon = mobileMenuButton.querySelector('#mobile-menu-icon');
                    if (icon) {
                        icon.classList.remove('fa-xmark');
                        icon.classList.add('fa-bars');
                    }
                });
            });

            // Close mobile menu when clicking outside
            document.addEventListener('click', function (event) {
                const isClickInside = mobileMenuButton.contains(event.target) || mobileMenu.contains(event.target);
                if (!isClickInside && !mobileMenu.classList.contains('hidden')) {
                    mobileMenu.classList.add('hidden');
                    const icon = mobileMenuButton.querySelector('#mobile-menu-icon');
                    if (icon) {
                        icon.classList.remove('fa-xmark');
                        icon.classList.add('fa-bars');
                    }
                }
            });
        }

        // Initialize on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeNavbar);
        } else {
            initializeNavbar();
        }

        // Also initialize on Turbo navigation
        document.addEventListener('turbo:load', initializeNavbar);
        document.addEventListener('turbo:render', initializeNavbar);
    })();
</script>
