<!-- Footer Section -->
<footer class="bg-pink-50">
  <!-- Top red line separator -->
  <div class="h-1 bg-red-600"></div>
  
  <div class="max-w-7xl mx-auto px-4 py-16">
    
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      
      <!-- African Ruby Column -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-red-600 rounded flex items-center justify-center mr-3">
            <span class="text-white font-bold text-xl">R</span>
          </div>
          <span class="text-xl font-bold text-gray-800">ARC Duka</span>
        </div>
        <p class="text-gray-600 text-sm mb-6 leading-relaxed">
          Celebrating African excellence in Ruby development through quality merchandise and community building.
        </p>
        <div class="flex space-x-4">

          <% arc_social_media_links.each do |link| %>
            <a href="<%= link[:url] %>" class="text-gray-600 hover:text-red-600 transition-colors">
              <i class="fab <%= link[:icon] %> text-2xl"></i>
            </a>
          <% end %>
        </div>
      </div>

      <!-- Products Column -->
      <div>
        <h3 class="text-lg font-bold text-red-700 mb-4">Products</h3>
        <ul class="space-y-2">
          <li><%= link_to "Shirts", category_path("Shirts"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Hoodies", category_path("Hoodies"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Hats", category_path("Hats"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Bags", category_path("Bags"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Mugs", category_path("Mugs"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Stickers", category_path("Stickers"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Accessories", category_path("Accessories"), class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
        </ul>
      </div>

      <!-- Community Column -->
      <div>
        <h3 class="text-lg font-bold text-red-700 mb-4">Community</h3>
        <ul class="space-y-2">
          <li><%= link_to "Ruby Community Africa", "https://rubycommunity.africa", target: "_blank", rel: "noopener noreferrer", class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Events", "https://rubyconf.africa/", target: "_blank", rel: "noopener noreferrer", class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Meetups", "https://www.meetup.com/african_ruby_community/", target: "_blank", rel: "noopener noreferrer", class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Blog", "https://rubyconf.africa/blog", target: "_blank", rel: "noopener noreferrer", class: "text-gray-600 text-sm hover:text-red-600 transition-colors", style: "display: none" %></li>
        </ul>
      </div>

      <!-- Support Column -->
      <div>
        <h3 class="text-lg font-bold text-red-700 mb-4">Support</h3>
        <ul class="space-y-2">
          <li><%= link_to "Contact Us", "mailto:info@rubycommunity.africa", class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><%= link_to "Shopping Cart", cart_path, class: "text-gray-600 text-sm hover:text-red-600 transition-colors" %></li>
          <li><a href="#" class="text-gray-600 text-sm hover:text-red-600 transition-colors" style="display: none" >Shipping Info</a></li>
          <li><a href="#" class="text-gray-600 text-sm hover:text-red-600 transition-colors" style="display: none">Returns Policy</a></li>
          <li><a href="#" class="text-gray-600 text-sm hover:text-red-600 transition-colors">FAQ</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Separator Line -->
    <div class="h-px bg-gray-300 mb-8"></div>

    <!-- Bottom Section -->
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="text-gray-600 text-sm mb-4 md:mb-0">
        © <%= Time.current.year %> African Ruby Community. Made with <span class="text-red-600">❤️</span> by ARC.
      </div>
      <div class="flex space-x-6">
        <a href="#" class="text-gray-600 text-sm hover:text-red-600 transition-colors">Privacy Policy</a>
        <a href="#" class="text-gray-600 text-sm hover:text-red-600 transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
