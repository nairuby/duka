<div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 mb-4 animate-slide-in-right" data-controller="flash" data-flash-dismiss-after-value="5000">
  <div class="flex items-start">
    <div class="flex-shrink-0">
      <i class="fas fa-exclamation-circle text-red-500 text-xl"></i>
    </div>
    <div class="ml-3 flex-1">
      <p class="text-sm font-medium text-red-800"><%= message %></p>
    </div>
    <button type="button" data-action="click->flash#dismiss" class="ml-3 flex-shrink-0 text-red-500 hover:text-red-700" aria-label="Dismiss">
      <i class="fas fa-times"></i>
    </button>
  </div>
</div>
