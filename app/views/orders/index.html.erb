<% content_for(:title, "My Orders") %>
<% content_for(:robots, "noindex, nofollow") %>

<%= render 'shared/navbar' %>

<section class="py-16 px-4 bg-gray-50 min-h-screen">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">My Orders</h1>
      <p class="text-gray-600">Track and view your recent community purchases</p>
    </div>

    <% if @orders.empty? %>
      <div class="bg-white rounded-2xl shadow-sm p-12 text-center">
        <i class="fas fa-box-open text-5xl text-gray-300 mb-4"></i>
        <h2 class="text-xl font-bold text-gray-700 mb-2">No orders placed yet</h2>
        <p class="text-gray-500 mb-6">Explore our official merchandise and wear your Ruby pride.</p>
        <%= link_to "Shop Products", products_path, class: "bg-red-600 hover:bg-red-700 text-white font-medium px-6 py-3 rounded-xl transition-colors shadow-sm inline-block" %>
      </div>
    <% else %>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-gray-50 text-gray-700 font-semibold uppercase text-xs border-b border-gray-200">
              <tr>
                <th class="px-6 py-4">Order #</th>
                <th class="px-6 py-4">Date</th>
                <th class="px-6 py-4">Status</th>
                <th class="px-6 py-4">Payment</th>
                <th class="px-6 py-4 text-right">Total</th>
                <th class="px-6 py-4 text-center">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @orders.each do |order| %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-800">
                    <%= order.order_number %>
                  </td>
                  <td class="px-6 py-4">
                    <%= order.created_at.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium capitalize <%= order.status == 'confirmed' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                      <%= order.status %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium capitalize <%= order.payment_status == 'paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                      <%= order.payment_status %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right font-semibold text-gray-800">
                    <%= order.currency %> <%= sprintf("%.2f", order.total) %>
                  </td>
                  <td class="px-6 py-4 text-center">
                    <%= link_to "View", order_path(order), class: "text-red-600 hover:text-red-800 font-medium text-sm" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%= render 'shared/footer' %>
