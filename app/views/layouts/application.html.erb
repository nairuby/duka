<!DOCTYPE html>
<html lang="en">
<head>
  <%= render "layouts/head" %>
</head>

<body>
<!-- Flash Messages -->
<% if notice.present? || alert.present? %>
  <div class="fixed top-4 right-4 z-50 max-w-md">
    <% if notice.present? %>
      <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4 shadow-lg mb-4 animate-slide-in-right" data-controller="flash" data-flash-dismiss-after-value="5000">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <i class="fas fa-check-circle text-green-500 text-xl"></i>
          </div>
          <div class="ml-3 flex-1">
            <p class="text-sm font-medium text-green-800"><%= notice %></p>
          </div>
          <button type="button" data-action="click->flash#dismiss" class="ml-3 flex-shrink-0 text-green-500 hover:text-green-700">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="bg-red-50 border-l-4 border-red-500 rounded-lg p-4 shadow-lg mb-4 animate-slide-in-right" data-controller="flash" data-flash-dismiss-after-value="5000">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <i class="fas fa-exclamation-circle text-red-500 text-xl"></i>
          </div>
          <div class="ml-3 flex-1">
            <p class="text-sm font-medium text-red-800"><%= alert %></p>
          </div>
          <button type="button" data-action="click->flash#dismiss" class="ml-3 flex-shrink-0 text-red-500 hover:text-red-700">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<main class="">
  <%= yield %>
</main>

<!-- Cart Preview Sidebar -->
<%= render 'carts/preview', cart: current_cart %>

<script>
    // Open cart if hash is present
    document.addEventListener('DOMContentLoaded', function () {
        if (window.location.hash === '#cart-open') {
            const cartPreview = document.getElementById('cart_preview')
            const cartBackdrop = document.getElementById('cart_backdrop')

            if (cartPreview && cartBackdrop) {
                setTimeout(() => {
                    cartPreview.classList.remove('translate-x-full')
                    cartBackdrop.classList.remove('hidden')
                    document.body.style.overflow = 'hidden'

                    // Remove hash from URL
                    history.replaceState(null, null, ' ')
                }, 100)
            }
        }
    })
</script>
</body>
</html>
