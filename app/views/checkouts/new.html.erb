<%= render 'shared/navbar' %>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Checkout</h1>
      <p class="text-sm sm:text-base text-gray-600">Complete your order</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Checkout Form -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8">
          <%= form_with model: @order, url: checkout_path, method: :post, class: "space-y-6" do |f| %>
            
            <!-- Contact Information -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-user text-red-600 mr-2"></i>
                Contact Information
              </h2>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <%= f.label :email, "Email Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= f.email_field :email, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "you@example.com" %>
                </div>
                
                <div>
                  <%= f.label :phone, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= f.telephone_field :phone, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "+254 700 000 000" %>
                </div>
              </div>
            </div>

            <!-- Shipping Information -->
            <div class="border-t pt-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-truck text-red-600 mr-2"></i>
                Shipping Address
              </h2>
              
              <div class="space-y-4">
                <div>
                  <%= f.label :shipping_name, "Full Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= f.text_field :shipping_name, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "John Doe" %>
                </div>
                
                <div>
                  <%= f.label :shipping_address, "Street Address", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= f.text_area :shipping_address, required: true, rows: 3, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "123 Main Street, Apartment 4B" %>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <%= f.label :shipping_city, "City", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= f.text_field :shipping_city, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "Nairobi" %>
                  </div>
                  
                  <div>
                    <%= f.label :shipping_postal_code, "Postal Code (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                    <%= f.text_field :shipping_postal_code, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "00100" %>
                  </div>
                </div>
                
                <div>
                  <%= f.label :shipping_country, "Country", class: "block text-sm font-medium text-gray-700 mb-2" %>
                  <%= f.select :shipping_country, 
                    [['Kenya', 'Kenya'], ['Uganda', 'Uganda'], ['Tanzania', 'Tanzania'], ['Rwanda', 'Rwanda'], ['Other', 'Other']], 
                    {}, 
                    class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none" %>
                </div>
              </div>
            </div>

            <!-- Order Notes -->
            <div class="border-t pt-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-sticky-note text-red-600 mr-2"></i>
                Order Notes (Optional)
              </h2>
              
              <%= f.text_area :notes, rows: 3, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-200 outline-none", placeholder: "Any special instructions for your order?" %>
            </div>

            <!-- Submit Button -->
            <div class="border-t pt-6">
              <%= f.submit "Continue to Payment", class: "w-full bg-red-600 text-white font-semibold py-4 px-6 rounded-xl hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center justify-center space-x-2" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-2xl shadow-lg p-6 sticky top-4">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Order Summary</h2>
          
          <!-- Cart Items -->
          <div class="space-y-4 mb-6 max-h-64 overflow-y-auto">
            <% current_cart.items.each do |item| %>
              <div class="flex items-start space-x-3 pb-4 border-b">
                <div class="w-16 h-16 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
                  <% if item.product.image_url.present? %>
                    <%= image_tag item.product.image_url, alt: item.product.name, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <i class="fas fa-image text-xl text-gray-300"></i>
                    </div>
                  <% end %>
                </div>
                
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-sm text-gray-800 truncate"><%= item.display_name %></h3>
                  <p class="text-xs text-gray-600">Qty: <%= item.quantity %></p>
                  <p class="text-sm font-bold text-red-600"><%= format_price(item.subtotal) %></p>
                </div>
              </div>
            <% end %>
          </div>
          
          <!-- Totals -->
          <div class="space-y-3 border-t pt-4">
            <div class="flex justify-between text-gray-600">
              <span>Subtotal</span>
              <span class="font-medium"><%= format_price(current_cart.total) %></span>
            </div>
            <div class="flex justify-between text-gray-600">
              <span>Shipping</span>
              <span class="font-medium">Calculated at next step</span>
            </div>
            <div class="border-t pt-3 flex justify-between text-lg font-bold text-gray-800">
              <span>Total</span>
              <span><%= format_price(current_cart.total) %>+</span>
            </div>
          </div>
          
          <!-- Security Badge -->
          <div class="mt-6 p-4 bg-green-50 rounded-lg">
            <div class="flex items-center text-sm text-green-800">
              <i class="fas fa-lock mr-2"></i>
              <span>Secure checkout</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'shared/footer' %>
