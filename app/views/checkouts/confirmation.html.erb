<%= render 'shared/navbar' %>

<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <!-- Success Message -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 bg-green-100 rounded-full mb-4">
        <i class="fas fa-check text-3xl sm:text-4xl text-green-600"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Order Confirmed!</h1>
      <p class="text-sm sm:text-base text-gray-600">Thank you for your order</p>
      <p class="text-base sm:text-lg font-semibold text-red-600 mt-2">Order #<%= @order.order_number %></p>
    </div>

    <!-- Order Details Card -->
    <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 mb-6">
      <!-- Order Status -->
      <div class="flex items-center justify-between mb-6 pb-6 border-b">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Order Status</h2>
          <p class="text-sm text-gray-600 mt-1">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
              <i class="fas fa-clock mr-2"></i>
              <%= @order.status.titleize %>
            </span>
          </p>
        </div>
        <div class="text-right">
          <h2 class="text-lg font-bold text-gray-900">Payment Status</h2>
          <p class="text-sm text-gray-600 mt-1">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @order.payment_status == 'paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
              <i class="fas <%= @order.payment_status == 'paid' ? 'fa-check-circle' : 'fa-clock' %> mr-2"></i>
              <%= @order.payment_status.titleize %>
            </span>
          </p>
        </div>
      </div>

      <!-- Order Items -->
      <div class="mb-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Order Items</h2>
        <div class="space-y-4">
          <% @order.order_items.each do |item| %>
            <div class="flex items-start space-x-4 pb-4 border-b last:border-b-0">
              <div class="w-20 h-20 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
                <% if item.product.image_url.present? %>
                  <%= image_tag item.product.image_url, alt: item.product_name, class: "w-full h-full object-cover" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center">
                    <i class="fas fa-image text-2xl text-gray-300"></i>
                  </div>
                <% end %>
              </div>
              
              <div class="flex-1">
                <h3 class="font-bold text-gray-800"><%= item.product_name %></h3>
                <% if item.variant_details.present? %>
                  <p class="text-sm text-gray-600"><%= item.variant_details %></p>
                <% end %>
                <p class="text-sm text-gray-600">Quantity: <%= item.quantity %></p>
                <p class="text-sm font-bold text-red-600 mt-1"><%= @order.currency %> <%= number_with_precision(item.subtotal, precision: 2) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Order Totals -->
      <div class="space-y-3 border-t pt-6">
        <div class="flex justify-between text-gray-600">
          <span>Subtotal</span>
          <span class="font-medium"><%= @order.currency %> <%= number_with_precision(@order.subtotal, precision: 2) %></span>
        </div>
        <div class="flex justify-between text-gray-600">
          <span>Shipping</span>
          <span class="font-medium"><%= @order.currency %> <%= number_with_precision(@order.shipping_cost, precision: 2) %></span>
        </div>
        <div class="border-t pt-3 flex justify-between text-xl font-bold text-gray-800">
          <span>Total</span>
          <span><%= @order.currency %> <%= number_with_precision(@order.total, precision: 2) %></span>
        </div>
      </div>
    </div>

    <!-- Shipping & Contact Info -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <!-- Shipping Address -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
          <i class="fas fa-truck text-red-600 mr-2"></i>
          Shipping Address
        </h2>
        <p class="text-gray-700">
          <%= @order.shipping_name %><br>
          <%= @order.shipping_address %><br>
          <%= @order.shipping_city %><% if @order.shipping_postal_code.present? %>, <%= @order.shipping_postal_code %><% end %><br>
          <%= @order.shipping_country %>
        </p>
      </div>

      <!-- Contact Info -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
          <i class="fas fa-envelope text-red-600 mr-2"></i>
          Contact Information
        </h2>
        <p class="text-gray-700">
          <strong>Email:</strong> <%= @order.email %><br>
          <strong>Phone:</strong> <%= @order.phone %>
        </p>
      </div>
    </div>

    <!-- Payment Method Info -->
    <% if @order.payment_method == 'cash_on_delivery' %>
      <div class="bg-orange-50 border-l-4 border-orange-500 rounded-lg p-6 mb-6">
        <div class="flex items-start">
          <i class="fas fa-info-circle text-orange-500 text-xl mr-3 mt-1"></i>
          <div>
            <h3 class="font-bold text-orange-900 mb-2">Cash on Delivery</h3>
            <p class="text-orange-800 text-sm">
              Please have <%= @order.currency %> <%= number_with_precision(@order.total, precision: 2) %> ready when your order arrives. 
              Our delivery person will collect payment upon delivery.
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Next Steps -->
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-6 mb-6">
      <div class="flex items-start">
        <i class="fas fa-lightbulb text-blue-500 text-xl mr-3 mt-1"></i>
        <div>
          <h3 class="font-bold text-blue-900 mb-2">What's Next?</h3>
          <ul class="text-blue-800 text-sm space-y-1">
            <li>• You'll receive an order confirmation email at <%= @order.email %></li>
            <li>• We'll notify you when your order ships</li>
            <li>• Track your order status anytime</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4">
      <%= link_to "Continue Shopping", root_path, class: "flex-1 bg-white text-gray-700 font-semibold py-3 px-6 rounded-xl border-2 border-gray-200 hover:border-red-600 hover:text-red-600 transition-all duration-200 text-center" %>
      <%= link_to "View Order", order_path(@order), class: "flex-1 bg-red-600 text-white font-semibold py-3 px-6 rounded-xl hover:bg-red-700 transition-all duration-200 text-center shadow-lg hover:shadow-xl" %>
    </div>
  </div>
</div>

<%= render 'shared/footer' %>
