<!-- Cart Preview Sidebar -->
<div id="cart_preview" class="fixed inset-y-0 right-0 w-full sm:w-96 bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50" data-controller="cart-preview">
  <div class="h-full flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b">
      <h2 class="text-xl font-bold text-gray-800">Shopping Cart (<%= cart.total_items %>)</h2>
      <button data-action="click->cart-preview#close" class="text-gray-500 hover:text-gray-700 transition-colors">
        <i class="fas fa-times text-2xl"></i>
      </button>
    </div>
    
    <% if cart.empty? %>
      <!-- Empty State -->
      <div class="flex-1 flex flex-col items-center justify-center p-6 text-center">
        <i class="fas fa-shopping-cart text-6xl text-gray-300 mb-4"></i>
        <h3 class="text-lg font-bold text-gray-800 mb-2">Your cart is empty</h3>
        <p class="text-gray-600 mb-6">Add some products to get started!</p>
        <button data-action="click->cart-preview#close" class="bg-red-600 text-white px-6 py-2 rounded-xl hover:bg-red-700 transition-colors">
          Continue Shopping
        </button>
      </div>
    <% else %>
      <!-- Cart Items -->
      <div class="flex-1 overflow-y-auto p-6 space-y-4">
        <% cart.items.each do |item| %>
          <div class="flex items-start space-x-4 pb-4 border-b">
            <!-- Product Image -->
            <div class="w-20 h-20 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
              <% if item.product.image_url.present? %>
                <%= image_tag item.product.image_url, alt: item.product.name, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <i class="fas fa-image text-2xl text-gray-300"></i>
                </div>
              <% end %>
            </div>
            
            <!-- Product Details -->
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm text-gray-800 mb-1 truncate"><%= item.display_name %></h3>
              <p class="text-xs text-gray-600 mb-2"><%= item.product.category %></p>
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <%= button_to update_quantity_cart_path(item.id), method: :patch, params: { quantity: item.quantity - 1 }, class: "w-6 h-6 bg-gray-100 rounded hover:bg-gray-200 transition-colors flex items-center justify-center text-xs" do %>
                    <i class="fas fa-minus"></i>
                  <% end %>
                  <span class="text-sm font-medium w-8 text-center"><%= item.quantity %></span>
                  <%= button_to update_quantity_cart_path(item.id), method: :patch, params: { quantity: item.quantity + 1 }, class: "w-6 h-6 bg-gray-100 rounded hover:bg-gray-200 transition-colors flex items-center justify-center text-xs" do %>
                    <i class="fas fa-plus"></i>
                  <% end %>
                </div>
                <p class="text-sm font-bold text-red-600"><%= item.product.currency %><%= number_with_precision(item.subtotal, precision: 2) %></p>
              </div>
            </div>
            
            <!-- Remove Button -->
            <%= button_to remove_item_cart_path(item.id), method: :delete, class: "text-gray-400 hover:text-red-600 transition-colors text-sm" do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </div>
        <% end %>
      </div>
      
      <!-- Footer with Total and Actions -->
      <div class="border-t p-6 space-y-4">
        <div class="flex justify-between text-lg font-bold text-gray-800">
          <span>Total</span>
          <span>USD <%= number_with_precision(cart.total, precision: 2) %></span>
        </div>
        
        <%= link_to cart_path, class: "w-full bg-white text-gray-700 py-3 rounded-xl border-2 border-gray-200 hover:border-red-600 hover:text-red-600 transition-all duration-200 flex items-center justify-center space-x-2 mb-2" do %>
          <i class="fas fa-shopping-cart"></i>
          <span class="font-medium">View Cart</span>
        <% end %>
        
        <%= link_to "#", class: "w-full bg-red-600 text-white py-3 rounded-xl hover:bg-red-700 transition-all duration-200 flex items-center justify-center space-x-2" do %>
          <span class="font-bold">Checkout</span>
          <i class="fas fa-arrow-right"></i>
        <% end %>
      </div>
      
      <!-- You May Also Like -->
      <% suggested = cart.suggested_products(limit: 2) %>
      <% if suggested.any? %>
        <div class="border-t p-6 bg-gray-50">
          <h3 class="text-sm font-bold text-gray-800 mb-4">You May Also Like</h3>
          <div class="space-y-3">
            <% suggested.each do |product| %>
              <%= link_to product_path(product), class: "flex items-center space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-all" do %>
                <div class="w-16 h-16 bg-gray-100 rounded-lg flex-shrink-0 overflow-hidden">
                  <% if product.image_url.present? %>
                    <%= image_tag product.image_url, alt: product.name, class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <i class="fas fa-image text-xl text-gray-300"></i>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-bold text-gray-800 truncate"><%= product.name %></h4>
                  <p class="text-sm font-bold text-red-600"><%= product.currency %><%= number_with_precision(product.price, precision: 2) %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Backdrop with Blur -->
<div id="cart_backdrop" class="fixed inset-0 bg-black/30 backdrop-blur-sm hidden z-40 transition-all duration-300" data-controller="cart-preview" data-action="click->cart-preview#close"></div>
