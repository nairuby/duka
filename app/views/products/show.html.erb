<%= render 'shared/navbar' %>

<!-- Product Detail Page -->
<section class="py-16 px-4 bg-gray-50 min-h-screen">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="flex items-center space-x-2 text-sm text-gray-600 mb-8">
      <%= link_to root_path, class: "hover:text-red-600 transition-colors" do %>
        <i class="fas fa-home"></i> Home
      <% end %>
      <span>/</span>
      <%= link_to products_path, class: "hover:text-red-600 transition-colors" do %>
        Products
      <% end %>
      <span>/</span>
      <span class="text-red-600 font-medium"><%= @product.name %></span>
    </div>

    <!-- Main Product Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <!-- Left Column - Product Image -->
      <div class="space-y-4">
        <div class="relative bg-white rounded-2xl overflow-hidden shadow-xl aspect-square group">
          <% if @product.image_url.present? %>
            <%= image_tag @product.image_url, alt: @product.name, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
          <% else %>
            <div class="w-full h-full bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
              <div class="text-center">
                <i class="fas fa-image text-6xl text-gray-400 mb-4"></i>
                <p class="text-gray-500 text-lg"><%= @product.name %></p>
              </div>
            </div>
          <% end %>
          
          <!-- Category Badge -->
          <div class="absolute top-4 left-4">
            <% category_info = product_category(@product) %>
            <span class="<%= category_badge_classes(category_info[:color]) %> text-xs font-medium px-3 py-1 rounded-full border">
              <i class="<%= category_info[:icon] %> mr-1"></i><%= category_info[:name] %>
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column - Product Details -->
      <div class="space-y-6" data-controller="product-detail">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-800 mb-4"><%= @product.name %></h1>
          <div class="flex items-baseline space-x-3 mb-4">
            <p class="text-3xl sm:text-4xl font-bold text-red-600">
              <%= @product.currency %><%= number_with_precision(@product.price, precision: 2) %>
            </p>
          </div>
        </div>

        <div class="prose prose-gray max-w-none">
          <p class="text-gray-700 leading-relaxed text-lg"><%= @product.description %></p>
        </div>

        <!-- Variant Selection -->
        <% if @variants.any? %>
          <div class="space-y-6 bg-white rounded-xl p-6 shadow-md">
            <!-- Size Selection -->
            <% sizes = @variants.map(&:size).uniq.compact %>
            <% if sizes.any? %>
              <div>
                <label class="block text-sm font-bold text-gray-800 mb-3">Select Size</label>
                <div class="flex flex-wrap gap-3">
                  <% sizes.each do |size| %>
                    <button 
                      type="button" 
                      class="px-6 py-3 border-2 border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:border-red-600 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 transition-all duration-200"
                      data-action="click->product-detail#selectSize"
                      data-size="<%= size %>"
                      data-product-detail-target="sizeButton"
                    >
                      <%= size %>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Color Selection -->
            <% colors = @variants.map(&:color).uniq.compact %>
            <% if colors.any? %>
              <div>
                <label class="block text-sm font-bold text-gray-800 mb-3">Select Color</label>
                <div class="flex flex-wrap gap-3">
                  <% colors.each do |color| %>
                    <button 
                      type="button" 
                      class="px-6 py-3 border-2 border-gray-300 rounded-xl text-sm font-medium text-gray-700 hover:border-red-600 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 transition-all duration-200"
                      data-action="click->product-detail#selectColor"
                      data-color="<%= color %>"
                      data-product-detail-target="colorButton"
                    >
                      <%= color %>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Stock Information -->
            <div class="flex items-center space-x-2 text-sm">
              <i class="fas fa-box text-gray-600"></i>
              <span class="font-medium text-gray-700">Stock:</span>
              <span data-product-detail-target="stockInfo" class="text-gray-600">Select options to see availability</span>
            </div>
          </div>
        <% else %>
          <!-- No Variants - Ready to Add -->
          <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4">
            <div class="flex items-center">
              <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
              <div>
                <p class="text-sm font-medium text-green-800">Ready to order</p>
                <p class="text-xs text-green-700">This product is available in standard configuration</p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Add to Cart Section -->
        <%= form_with url: add_item_cart_path, method: :post, data: { controller: "cart-form", action: "submit->cart-form#submit", product_detail_target: "cartForm" } do |f| %>
          <%= f.hidden_field :product_id, value: @product.id %>
          <%= f.hidden_field :variant_id, value: nil, data: { product_detail_target: "variantIdField" } %>
          
          <div class="flex items-center space-x-4 mb-6">
            <label class="text-sm font-bold text-gray-800">Quantity:</label>
            <div class="flex items-center space-x-3 bg-white rounded-xl border-2 border-gray-200 px-4 py-2">
              <button type="button" data-action="click->product-detail#decreaseQuantity" class="text-gray-600 hover:text-red-600 transition-colors">
                <i class="fas fa-minus"></i>
              </button>
              <%= f.number_field :quantity, value: 1, min: 1, class: "w-16 text-center font-bold text-gray-800 border-0 focus:outline-none", data: { product_detail_target: "quantityInput" } %>
              <button type="button" data-action="click->product-detail#increaseQuantity" class="text-gray-600 hover:text-red-600 transition-colors">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          </div>

          <div class="space-y-3">
            <% if @variants.any? %>
              <%= f.submit "Add to Cart", class: "w-full bg-red-600 text-white py-4 px-6 rounded-xl font-bold text-lg hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-500 focus:ring-opacity-50 transition-all duration-200 transform hover:scale-105 shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100", data: { product_detail_target: "addToCartBtn" }, disabled: true %>
            <% else %>
              <%= f.submit "Add to Cart", class: "w-full bg-red-600 text-white py-4 px-6 rounded-xl font-bold text-lg hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-500 focus:ring-opacity-50 transition-all duration-200 transform hover:scale-105 shadow-lg hover:shadow-xl" %>
            <% end %>
            
            <%= link_to cart_path, class: "w-full bg-white text-gray-700 py-4 px-6 rounded-xl font-bold text-lg border-2 border-gray-200 hover:border-red-600 hover:text-red-600 transition-all duration-200 flex items-center justify-center space-x-2" do %>
              <i class="fas fa-shopping-cart"></i>
              <span>View Cart</span>
            <% end %>
          </div>
        <% end %>

        <!-- Product Features -->
        <div class="grid grid-cols-2 gap-4 pt-6 border-t">
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
              <i class="fas fa-shipping-fast text-red-600"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">Fast Shipping</p>
              <p class="text-xs text-gray-600">2-5 business days</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
              <i class="fas fa-shield-alt text-green-600"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">Quality Guaranteed</p>
              <p class="text-xs text-gray-600">Premium materials</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              <i class="fas fa-heart text-blue-600"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">Made in Africa</p>
              <p class="text-xs text-gray-600">Supporting local</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
              <i class="fas fa-users text-purple-600"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">Community</p>
              <p class="text-xs text-gray-600">Ruby developers</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Additional Information Tabs -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Product Details -->
        <div>
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-info-circle text-red-600 mr-2"></i>
            Product Details
          </h3>
          <div class="space-y-3 text-sm text-gray-700">
            <div class="flex justify-between py-2 border-b">
              <span class="font-medium">Material:</span>
              <span>Premium Cotton Blend</span>
            </div>
            <div class="flex justify-between py-2 border-b">
              <span class="font-medium">Care Instructions:</span>
              <span>Machine Wash Cold</span>
            </div>
            <div class="flex justify-between py-2 border-b">
              <span class="font-medium">Origin:</span>
              <span>Made in Kenya</span>
            </div>
            <div class="flex justify-between py-2">
              <span class="font-medium">Category:</span>
              <span><%= @product.category %></span>
            </div>
          </div>
        </div>

        <!-- Important Notice -->
        <div>
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-exclamation-triangle text-yellow-600 mr-2"></i>
            Important Notice
          </h3>
          <div class="space-y-2 text-sm text-gray-700">
            <p class="flex items-start">
              <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
              <span>All sales are final. No returns or exchanges.</span>
            </p>
            <p class="flex items-start">
              <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
              <span>Colors may vary slightly from what appears on your screen.</span>
            </p>
            <p class="flex items-start">
              <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
              <span>Please check size chart carefully before ordering.</span>
            </p>
            <p class="flex items-start">
              <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
              <span>Delivery times may vary based on location.</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    <% related_products = Product.where(category: @product.category).where.not(id: @product.id).limit(4) %>
    <% if related_products.any? %>
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-8">You May Also Like</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <% related_products.each do |product| %>
            <%= link_to product_path(product), class: "group bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1" do %>
              <div class="relative overflow-hidden h-48 bg-gray-100">
                <% if product.image_url.present? %>
                  <%= image_tag product.image_url, alt: product.name, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center">
                    <i class="fas fa-image text-4xl text-gray-300"></i>
                  </div>
                <% end %>
              </div>
              <div class="p-4">
                <h3 class="font-bold text-gray-800 mb-2 line-clamp-1"><%= product.name %></h3>
                <p class="text-lg font-bold text-red-600"><%= product.currency %><%= number_with_precision(product.price, precision: 2) %></p>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%= render 'shared/footer' %>

<script>
  // Store variants data for JavaScript access
  window.productVariants = <%= raw @variants.to_json(only: [:id, :size, :color, :stock_quantity, :sku]) %>;
</script>
