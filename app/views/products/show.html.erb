<div class="container mx-auto px-4 py-8" data-controller="product-viewer" data-variants="<%= @variants.to_json(only: [:size, :color, :stock_quantity, :sku]) %>">
  <!-- Main Product Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
    <!-- Left Column - Product Image -->
    <div class="space-y-4">
      <div class="relative bg-gray-100 rounded-lg overflow-hidden aspect-square">
        <% if @product.image_url.present? %>
          <img src="<%= @product.image_url %>" 
               alt="<%= @product.name %>" 
               class="w-full h-full object-cover" />
        <% else %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
              <span class="text-gray-500 text-lg">Product Image</span>
            </div>
          </div>
        <% end %>
        <!-- Zoom overlay for future implementation -->
        <div class="absolute top-4 right-4 bg-white rounded-full p-2 shadow-md cursor-pointer hover:bg-gray-50">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Right Column - Product Details -->
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @product.name %></h1>
        <p class="text-2xl font-semibold text-green-600">
          <%= @product.currency %> <%= number_with_precision(@product.price, precision: 2) %>
        </p>
      </div>

      <div class="prose prose-gray max-w-none">
        <p class="text-gray-700 leading-relaxed"><%= @product.description %></p>
      </div>

      <!-- Variant Selection -->
      <% if @variants.any? %>
        <div class="space-y-4" data-product-viewer-target="variantSelector">
          <!-- Size Selection -->
          <% if @variants.map(&:size).uniq.compact.any? %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Size</label>
              <div class="flex flex-wrap gap-2">
                <% @variants.map(&:size).uniq.compact.each do |size| %>
                  <button 
                    type="button" 
                    class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    data-action="click->product-viewer#selectSize"
                    data-size="<%= size %>"
                  >
                    <%= size %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Color Selection -->
          <% if @variants.map(&:color).uniq.compact.any? %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Color</label>
              <div class="flex flex-wrap gap-2">
                <% @variants.map(&:color).uniq.compact.each do |color| %>
                  <button 
                    type="button" 
                    class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    data-action="click->product-viewer#selectColor"
                    data-color="<%= color %>"
                  >
                    <%= color %>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Stock Information -->
          <div class="text-sm text-gray-600" data-product-viewer-target="stockInfo">
            <span class="font-medium">Stock:</span> 
            <span data-product-viewer-target="stockCount">Select variant to see availability</span>
          </div>
        </div>
      <% end %>

      <!-- Add to Cart Button -->
      <div class="pt-4">
        <button 
          type="button" 
          class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
          data-product-viewer-target="addToCartBtn"
          disabled
        >
          Select Options
        </button>
      </div>
    </div>
  </div>

  <!-- Additional Information Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Additional Info -->
    <div class="bg-gray-50 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Additional Information</h3>
      <div class="space-y-3 text-sm text-gray-600">
        <div class="flex justify-between">
          <span class="font-medium">Material:</span>
          <span>Premium Cotton Blend</span>
        </div>
        <div class="flex justify-between">
          <span class="font-medium">Care Instructions:</span>
          <span>Machine Wash Cold</span>
        </div>
        <div class="flex justify-between">
          <span class="font-medium">Origin:</span>
          <span>Made in Kenya</span>
        </div>
        <div class="flex justify-between">
          <span class="font-medium">SKU:</span>
          <span data-product-viewer-target="selectedSku">-</span>
        </div>
      </div>
    </div>

    <!-- Buyer Beware -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-yellow-800 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
        </svg>
        Important Notice
      </h3>
      <div class="text-sm text-yellow-700 space-y-2">
        <p>• All sales are final. No returns or exchanges.</p>
        <p>• Colors may vary slightly from what appears on your screen.</p>
        <p>• Please check size chart carefully before ordering.</p>
        <p>• Delivery times may vary based on location.</p>
      </div>
    </div>
  </div>
</div>
