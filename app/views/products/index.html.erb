<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Our Products</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @products.each do |product| %>
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
        <div class="aspect-square bg-gray-200 flex items-center justify-center overflow-hidden">
          <% if product.image_url.present? %>
            <img src="<%= product.image_url %>" 
                 alt="<%= product.name %>" 
                 class="w-full h-full object-cover hover:scale-110 transition-transform duration-300" />
          <% else %>
            <span class="text-gray-500">Product Image</span>
          <% end %>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= product.name %></h3>
          <p class="text-gray-600 text-sm mb-4 line-clamp-2"><%= truncate(product.description, length: 100) %></p>
          <div class="mb-3">
            <% category = product_category(product) %>
            <span class="<%= category_badge_classes(category[:color]) %> text-xs font-medium px-2 py-1 rounded-full border">
              <i class="<%= category[:icon] %> mr-1"></i><%= category[:name] %>
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold text-green-600">
              <%= product.currency %> <%= number_with_precision(product.price, precision: 2) %>
            </span>
            <%= link_to "View Details", product_path(product), 
                class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>